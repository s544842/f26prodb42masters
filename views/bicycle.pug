extends layout

block content
	a(href="/") <-
	br
	- let items = results;
	
	script.
		function buy(i){
			alert("You purchased item "+i);
		}

	div(class="container-fluid")
		div(class="row")
			each item,index in items
				div(class="col-sm-2", onClick=`buy(${index})`) Bicycle #{index} - Wheels: #{item.wheels}, Color: #{item.color}, Brand: #{item.brand}
