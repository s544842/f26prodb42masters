extends layout

block content
	p Rows: #{query.rows}, Cols: #{query.cols}
	- var rows = Number(query.rows);
	- var cols = Number(query.cols);
	if !(Number.isInteger(rows)) || !(Number.isInteger(cols))
		p Rows/Cols contains non-integers
	else if rows < 2 || rows > 12
		p Rows out of bounds (2-12)
	else if cols < 2 || cols > 12
		p Cols out of bounds (2-12)
	else
		table#outer
			- for (let i = 0; i < cols; i++) {
				tr#middle
					- for (let j = 0; j < rows; j++) {
						td= i - j
					- }
			- }
